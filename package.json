{
  "name": "merqo-business-management",
  "productName": "MERQO",
  "version": "0.1.0",
  "private": true,
  "description": "MERQO offline business management and super shop POS for Bangladesh",
  "author": "MERQO <merqoonline@gmail.com>",
  "license": "UNLICENSED",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build/build-electron.mjs",
    "build:win": "npm run build && electron-builder --win --x64 --publish never",
    "build:generator": "node scripts/build/build-generator.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.ts\"",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "licenses": "node scripts/dev/check-licenses.mjs",
    "secrets": "python3 scripts/dev/secret_scan.py",
    "db:verify": "node scripts/database/verify.mjs",
    "postinstall": "node scripts/dev/copy-assets.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.ts\"",
    "smoke": "node scripts/dev/smoke-preview.mjs",
    "checklist": "python3 scripts/dev/update-checklist.py --committed && python3 scripts/dev/generate_requirements.py"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "date-fns": "4.1.0",
    "exceljs": "4.4.0",
    "lucide-react": "0.544.0",
    "pdfkit": "0.17.2",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.2.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@expo-google-fonts/noto-sans-bengali": "0.4.4",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.6",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.8.1",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.10",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vite": "7.2.2",
    "vitest": "3.2.4"
  }
}
